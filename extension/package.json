{
  "name": "semantic-navigator",
  "displayName": "Semantic Navigator",
  "description": "Semantic code search powered by vector embeddings and hybrid RRF retrieval",
  "version": "0.1.0",
  "publisher": "kontur-team",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "semanticNavigator.search",
        "title": "Search Code",
        "category": "Semantic Navigator"
      },
      {
        "command": "semanticNavigator.indexWorkspace",
        "title": "Reindex Workspace",
        "category": "Semantic Navigator"
      }
    ],
    "keybindings": [
      {
        "command": "semanticNavigator.search",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "semantic-navigator",
          "title": "Semantic Navigator",
          "icon": "media/search.svg"
        }
      ]
    },
    "views": {
      "semantic-navigator": [
        {
          "id": "semanticNavigator.resultsView",
          "name": "Search Results"
        }
      ]
    },
    "configuration": {
      "title": "Semantic Navigator",
      "properties": {
        "semanticNavigator.providerUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible embeddings endpoint URL (OpenAI, Ollama, LM Studio, or internal gateway)"
        },
        "semanticNavigator.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the embedding provider"
        },
        "semanticNavigator.model": {
          "type": "string",
          "default": "text-embedding-3-small",
          "description": "Model identifier for generating embeddings"
        },
        "semanticNavigator.enginePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the custom semantic-engine binary"
        },
        "semanticNavigator.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable indexing and search with the configured provider. Source code will be sent to that provider."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "../scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/project-navigator/SemanticNavigator.git"
  },
  "license": "MIT",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Indexing launches a local engine and sends source code to the configured provider."
    },
    "virtualWorkspaces": false
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  }
}
